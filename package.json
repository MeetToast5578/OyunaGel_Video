{
  "name": "oyunagel-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "node --experimental-strip-types --no-warnings audio/dump.mjs > audio/cues.json && python3 audio/make.py audio/cues.json public/audio/mix.wav",
    "render": "remotion render src/index.ts Promo renders/OyunaGel_launch_AZ_master.mp4 --crf=16 --audio-bitrate=320k",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
